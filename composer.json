{
    "name": "drupal/marvin",
    "description": "Set of developer helper Drush commands",
    "type": "drupal-drush",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "drupal",
        "drupal-11",
        "drush",
        "marvin"
    ],
    "authors": [
        {
            "name": "Dávid Andor",
            "role": "Maintainer",
            "homepage": "https://github.com/Sweetchuck"
        }
    ],
    "homepage": "https://github.com/Sweetchuck/drupal-marvin",
    "support": {
        "source": "https://github.com/Sweetchuck/drupal-marvin",
        "issues": "https://github.com/Sweetchuck/drupal-marvin/issues"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pcre": "*",
        "composer/composer": "^2.4",
        "consolidation/robo": "^5.0",
        "sweetchuck/drupal-drush-helper": "1.x-dev",
        "sweetchuck/git-hooks-stdinput-reader": "1.x-dev",
        "sweetchuck/lint-report": "1.x-dev",
        "sweetchuck/robo-git": "4.x-dev",
        "sweetchuck/robo-nvm": "4.x-dev",
        "sweetchuck/robo-yarn": "4.x-dev",
        "sweetchuck/utils": "2.x-dev",
        "symfony/filesystem": "^6.0 || ^7.0",
        "symfony/string": "^6.3 || ^7.0"
    },
    "require-dev": {
        "ext-dom": "*",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^9.0",
        "weitzman/drupal-test-traits": "^2.1"
    },
    "suggest": {
        "drush/drush": "^13.7"
    },
    "autoload": {
        "psr-4": {
            "Drupal\\marvin\\": "src/"
        }
    }
}
